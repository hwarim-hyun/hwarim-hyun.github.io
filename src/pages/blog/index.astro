---
import Base from '../../layouts/Base.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---
<Base title="Notes" description="Notes on research, engineering, and things I learned.">
  <h1>Notes</h1>
  <p class="muted">Occasional writing on research, systems, and things I learned the hard way. <a href="/rss.xml">RSS</a></p>
  {posts.length === 0 && <p class="faint">Nothing here yet.</p>}
  <ul class="post-list">
    {posts.map((p) => (
      <li>
        <FormattedDate date={p.data.date} />
        <div>
          <a href={`/blog/${p.id}`}>{p.data.title}</a>
          <p class="desc">{p.data.description}</p>
        </div>
      </li>
    ))}
  </ul>
</Base>
