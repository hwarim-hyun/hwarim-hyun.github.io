---
// 프로젝트 상세 페이지의 소속 단체 소개 줄. 첫 키는 front-matter org 의 " · " 앞부분 (e.g. "NAVER · AI Safety Center" → "NAVER"),
// 그 뒤에 front-matter orgs 의 키들이 추가 행으로 붙는다. 키는 src/data/orgs.json 에 있어야 렌더된다.
import orgs from '../data/orgs.json';
type Info = { name: string; url?: string; logo?: string; description: string };
interface Props { org?: string; extra?: string[] }
const { org, extra = [] } = Astro.props;
const keys = [org?.split('·')[0].trim() ?? '', ...extra];
const rows = keys
  .map((k) => (orgs as Record<string, Info>)[k])
  .filter((info): info is Info => Boolean(info))
  .map((info) => {
    // 설명이 단체명("The …" 포함)으로 시작하면 그 부분만 굵게 (링크 포함)
    const lead = [info.name, `The ${info.name}`].find((n) => info.description.startsWith(n));
    return { info, lead, rest: lead ? info.description.slice(lead.length) : info.description };
  });
---
{rows.length > 0 && (
  <aside class="org-note">
    {rows.map(({ info, lead, rest }) => (
      <div class="org-row">
        {info.logo && (info.url
          ? <a class="org-logo" href={info.url} rel="noopener" target="_blank" aria-label={info.name}><img src={info.logo} alt={info.name} loading="lazy" /></a>
          : <span class="org-logo"><img src={info.logo} alt={info.name} loading="lazy" /></span>)}
        <p>
          {lead && (info.url
            ? <a href={info.url} rel="noopener" target="_blank"><strong>{lead}</strong></a>
            : <strong>{lead}</strong>)}{rest}
        </p>
      </div>
    ))}
  </aside>
)}
