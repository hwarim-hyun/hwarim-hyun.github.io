---
import Base from '../layouts/Base.astro';
import SocialLinks from '../components/SocialLinks.astro';
import ProjectCard from '../components/ProjectCard.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE, PROFILE } from '../site.config';
import { getCollection } from 'astro:content';
import { sortProjects, sortAlbums } from '../lib/sort';
import { marked } from 'marked';
import news from '../data/news.json';
import NewsItem from '../components/NewsItem.astro';
import type { NewsLink } from '../components/NewsItem.astro';
import highlights from '../data/highlights.json';

// JSON 문자열 안의 줄바꿈(\n)을 <br> 로. 인라인 마크다운도 함께 처리.
const inline = (t: string) => marked.parseInline(t.replace(/\n/g, '<br>')) as string;

const featured = sortProjects((await getCollection('projects')).filter((p) => p.data.featured));
const recentNews = (news as { date: string; text: string; links?: NewsLink[] }[])
  .map((n) => ({ ...n, date: new Date(n.date) }))
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 3);
// highlights.json 항목은 문자열이거나 { text } 객체 둘 다 허용
const hl = (highlights as (string | { text: string })[]).map((h) => (typeof h === 'string' ? { text: h } : h));
// Outside of Work 앨범 (src/content/albums). 비어 있으면 섹션 숨김
const albums = sortAlbums((await getCollection('albums')).filter((a) => !a.data.hidden));
// profile.json 의 introFold: 앞에서 몇 문단까지 보여주고 나머지는 "Read more" 뒤로 접을지
const fold = PROFILE.introFold ?? PROFILE.intro.length;
const visibleIntro = PROFILE.intro.slice(0, fold);
const hiddenIntro = PROFILE.intro.slice(fold);
---
<Base>
  <section class="hero">
    <div class="hero-top">
      <img class="avatar" src={PROFILE.avatar} alt={`Photo of ${PROFILE.name}`} width="120" height="120" loading="eager" />
      <div>
        <h1>{PROFILE.displayName || PROFILE.name}</h1>
        <p class="tagline" set:html={inline(PROFILE.tagline)} />
      </div>
    </div>
    <div class="intro">
      {visibleIntro.map((p) => <p set:html={inline(p)} />)}
      {hiddenIntro.length > 0 && (
        <>
          <div class="intro-more" id="intro-more" hidden>
            {hiddenIntro.map((p) => <p set:html={inline(p)} />)}
            {PROFILE.keywords && <p class="keywords">{PROFILE.keywords}</p>}
          </div>
          <button class="link-btn" type="button" id="intro-toggle" aria-expanded="false" aria-controls="intro-more">Read more ↓</button>
        </>
      )}
      {PROFILE.skills?.length > 0 && (
        <ul class="skills" aria-label="Representative skills">
          {PROFILE.skills.map((k) => <li class="pill pill-accent">{k}</li>)}
        </ul>
      )}
    </div>
    <SocialLinks />
  </section>

  {featured.length > 0 && (
    <section class="featured">
      <div class="section-head">
        <h2>Featured Projects</h2>
        <a href="/projects">All projects →</a>
      </div>
      <div class="grid featured-grid">
        {featured.map((p) => <ProjectCard project={p} size="large" />)}
      </div>
    </section>
  )}

  {recentNews.length > 0 && (
    <section>
      <div class="section-head">
        <h2>News</h2>
        <a href="/news">All news →</a>
      </div>
      <ul class="news">
        {recentNews.map((n) => <NewsItem item={n} />)}
      </ul>
    </section>
  )}

  {hl.length > 0 && (
    <section>
      <h2>Highlights</h2>
      <ul class="highlights">
        {hl.map((h) => <li set:html={inline(h.text)} />)}
      </ul>
    </section>
  )}

  {albums.length > 0 && (
    <section id="outside">
      <h2>Outside of Work</h2>
      <div class="album-grid">
        {albums.map((a) => (
          <figure class="album-card">
            <img src={a.data.cover} alt={a.data.title} loading="lazy" draggable="false" style={`object-position: ${a.data.coverPosition}`} />
            <figcaption class="album-title">{a.data.title}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}
</Base>
<script>
  const btn = document.getElementById('intro-toggle');
  const more = document.getElementById('intro-more');
  btn?.addEventListener('click', () => {
    const open = more!.hidden;
    more!.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
    btn.textContent = open ? 'Show less ↑' : 'Read more ↓';
  });
</script>
<script>
  document.querySelectorAll('.album-card img').forEach((img) => {
    img.addEventListener('contextmenu', (e) => e.preventDefault());
    img.addEventListener('dragstart', (e) => e.preventDefault());
  });
</script>
