---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { sortProjects } from '../../lib/sort';

const projects = sortProjects(await getCollection('projects'));
---
<Base title="Projects" description="Selected research and engineering projects.">
  <h1>Projects</h1>
  <p class="muted">Production systems, evaluation infrastructure, and open-source work. Each entry lists the context, what I built, and the measured impact.</p>
  {projects.length === 0 ? (
    <p class="faint">Nothing here yet.</p>
  ) : (
    <div class="grid">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  )}
</Base>
