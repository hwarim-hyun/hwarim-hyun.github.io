---
import Base from '../layouts/Base.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { marked } from 'marked';
import news from '../data/news.json';

const inline = (t: string) => marked.parseInline(t.replace(/\n/g, '<br>')) as string;
const items = (news as { date: string; text: string }[])
  .map((n) => ({ ...n, date: new Date(n.date) }))
  .sort((a, b) => b.date.getTime() - a.date.getTime());
const years = [...new Set(items.map((n) => n.date.getUTCFullYear()))];
---
<Base title="News" description="News and updates by year.">
  <h1>News</h1>
  <p class="muted">Talks, papers, press, and other updates, by year.</p>
  {years.map((y) => (
    <>
      <p class="year-head" id={String(y)}>{y}</p>
      <ul class="news">
        {items.filter((n) => n.date.getUTCFullYear() === y).map((n) => (
          <li>
            <FormattedDate date={n.date} />
            <p set:html={inline(n.text)} />
          </li>
        ))}
      </ul>
    </>
  ))}
</Base>
