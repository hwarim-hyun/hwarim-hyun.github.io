---
import Base from '../../layouts/Base.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((p) => ({ params: { id: p.id }, props: { post: p } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
---
<Base title={d.title} description={d.description} type="article">
  <article>
    <header class="article-head">
      <p class="small"><a href="/blog">← Notes</a></p>
      <h1>{d.title}</h1>
      <p class="meta">
        <FormattedDate date={d.date} />
        {d.tags.length > 0 && <span> · {d.tags.join(', ')}</span>}
      </p>
    </header>
    <div class="prose"><Content /></div>
  </article>
</Base>
